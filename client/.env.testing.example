# Firebase Web App Configuration (from 'firebase apps:sdkconfig WEB <APP_ID> --project <PROJECT_ID>')
VITE_FIREBASE_API_KEY=YOUR_TESTING_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=univillage-testing-a640c.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=univillage-testing-a640c
VITE_FIREBASE_STORAGE_BUCKET=univillage-testing-a640c.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_TESTING_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_TESTING_FIREBASE_WEB_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=

# Inventory Cloud Run Backend API URL (Testing)
# E.g. https://k2k-inventory-api-42827689186.us-central1.run.app (No trailing slash)
VITE_BACKEND_URL=https://k2k-inventory-api-42827689186.us-central1.run.app

