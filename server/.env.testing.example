# Univillage Inventory Backend - Testing Environment Configuration Example
# Copy to .env.testing for local testing or inject into Google Cloud Run environment variables

NODE_ENV=production
APP_ENV=testing

# Target Testing Firebase / GCP Project
FIREBASE_PROJECT_ID=univillage-testing-a640c
FIREBASE_STORAGE_BUCKET=univillage-testing-a640c.firebasestorage.app

# Server Port (Cloud Run injects PORT=8080 automatically)
PORT=8080

# CORS & Frontend Origins
FRONTEND_URL=https://univillage-inventory-testing.web.app
ALLOWED_ORIGINS=https://univillage-inventory-testing.web.app,https://univillage-inventory-testing.firebaseapp.com,http://localhost:5173,http://localhost:8080

# Application Secret Key (for custom admin JWT exchange if used)
JWT_SECRET=testing_jwt_secret_placeholder

